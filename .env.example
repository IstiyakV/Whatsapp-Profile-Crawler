# Server
PORT=3030

# Phone normalization
DEFAULT_COUNTRY_CODE=+880

# Browser mode: false opens a visible browser for QR login
HEADLESS=false

# Speed profiles are controlled from the UI per task.
# These values are used as Balanced defaults.
MIN_DELAY_MS=2500
MAX_DELAY_MS=6000
MIN_COOLDOWN_MS=3000
MAX_COOLDOWN_MS=9000
MAX_RETRIES=2

# Runtime paths
DB_PATH=data/crawler.db
SESSION_DIR=sessions
IMAGES_DIR=images
LOGS_DIR=logs
UPLOADS_DIR=uploads
